{% extends 'base.html.twig' %}

{% block title %}Modifier Profil
{% endblock %}

{% block body %}
<div
	class="container py-5">
	<!-- SECTION TITRE -->
	<div class="card mb-4 bg-light">
		<div class="card-body text-center">
			<h1 class="mb-0 fw-bold">
				{% if not pastry_chef.isProfileCompleted %}
					Compléter Votre Profil
				{% else %}
					Modifier Votre Profil
				{% endif %}
			</h1>
		</div>
	</div>

	<!-- SECTION FORMULAIRE -->
	<div class="row justify-content-center">
		<div class="col-md-10 col-lg-8">
			<div class="card border-0 shadow-sm bg-light">
				<div class="card-body p-4">
					{{ form_errors(form) }}
					{{ form_start(form) }}

					<!-- Informations de contact -->
					<div class="mb-4">
						<h4 class="fw-bold mb-3 border-bottom pb-2">
							Informations de contact
						</h4>

						<div class="mb-3">
							{{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
							<div class="input-group">
								<span class="input-group-text bg-body">
									<i class="bi bi-envelope text-muted"></i>
								</span>
								{{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com'}}) }}
							</div>
							{{ form_errors(form.email) }}
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								{{ form_label(form.firstname, 'Prénom', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-person text-muted"></i>
									</span>
									{{ form_widget(form.firstname, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
								</div>
								{{ form_errors(form.firstname) }}
							</div>
							<div class="col-md-6 mb-3">
								{{ form_label(form.lastname, 'Nom', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-person text-muted"></i>
									</span>
									{{ form_widget(form.lastname, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom'}}) }}
								</div>
								{{ form_errors(form.lastname) }}
							</div>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								{{ form_label(form.pseudo, 'Pseudo', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-person text-muted"></i>
									</span>
									{{ form_widget(form.pseudo, {'attr': {'class': 'form-control', 'placeholder': 'Votre pseudo'}}) }}
								</div>
								{{ form_errors(form.pseudo) }}
							</div>
							<div class="col-md-6 mb-3">
								{{ form_label(form.phone, 'Téléphone', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-telephone text-muted"></i>
									</span>
									{{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'Votre téléphone'}}) }}
								</div>
								{{ form_errors(form.phone) }}
							</div>
						</div>

						<div class="mb-3">
							{{ form_label(form.city, 'Ville', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
							<div class="input-group">
								<span class="input-group-text bg-body">
									<i class="bi bi-geo-alt text-muted"></i>
								</span>
								{{ form_widget(form.city, {'attr': {'class': 'form-control', 'placeholder': 'Votre ville'}}) }}
							</div>
							{{ form_errors(form.city) }}
						</div>
					</div>

					<!-- Informations professionnelles -->
					<div class="mb-4">
						<h4 class="fw-bold mb-3 border-bottom pb-2">
							<i class="bi bi-briefcase me-2"></i>Informations professionnelles
						</h4>

						<div class="row">
							<div
								class="col-md-6 mb-3">
								<!-- Spécialités -->
								<div class="mb-3">
									{{ form_label(form.speciality, 'Spécialités', {'label_attr': {'class': 'form-label fw-semibold'}}) }}

									<div class="form-check-group">
										{% for choice in form.speciality %}
											<div class="form-check">
												{{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
												{{ form_label(choice, null, {'label_attr': {'class': 'form-check-label'}}) }}
											</div>
										{% endfor %}
									</div>

									{{ form_errors(form.speciality) }}
									<div class="form-text">
										<small class="text-muted">
											<i class="bi bi-info-circle me-1"></i>
											Sélectionnez 1 spécialité
										</small>
									</div>
								</div>
							</div>
							<div class="col-md-6 mb-3">
								{{ form_label(form.price, 'Tarif horaire (€)', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-currency-euro text-muted"></i>
									</span>
									{{ form_widget(form.price, {'attr': {'class': 'form-control', 'placeholder': '50'}}) }}
								</div>
								{{ form_errors(form.price) }}
							</div>
						</div>

						<div class="mb-3">
							{{ form_label(form.experience, 'Années d\'expérience', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-clock-history text-muted"></i>
									</span>
									{{ form_widget(form.experience, {'attr': {'class': 'form-control', 'placeholder': '5'}}) }}
								</div>
								{{ form_errors(form.experience) }}
							</div>

							<div class="mb-3">
								{{ form_label(form.websiteLink, 'Site web', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-globe text-muted"></i>
									</span>
									{{ form_widget(form.websiteLink, {'attr': {'class': 'form-control', 'placeholder': 'https://votre-site.com'}}) }}
								</div>
								{{ form_errors(form.websiteLink) }}
							</div>

							<div class="mb-3">
								{{ form_label(form.socialLink, 'Réseau social', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-link-45deg text-muted"></i>
									</span>
									{{ form_widget(form.socialLink, {'attr': {'class': 'form-control', 'placeholder': 'https://votre-profil.com'}}) }}
								</div>
								{{ form_errors(form.socialLink) }}
							</div>

							<div class="mb-3">
								{{ form_label(form.photoUrl, 'Photo de profil', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-body">
										<i class="bi bi-image text-muted"></i>
									</span>
									{{ form_widget(form.photoUrl, {'attr': {'class': 'form-control', 'placeholder': 'URL de votre photo'}}) }}
								</div>
								{{ form_errors(form.photoUrl) }}
							</div>
						</div>

						<!-- Champs cachés -->
						{{ form_widget(form.password, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.createdAt, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.isVerified, {'attr': {'hidden': true}}) }}

						<!-- BOUTONS ACTION -->
						<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
							<a href="{{ path('app_pastry_chef_show', {'id': pastry_chef.id}) }}" class="btn-cancel">
								<i class="bi bi-arrow-left me-2"></i>
								{% if not pastry_chef.isProfileCompleted %}
									Retour
								{% else %}
									Retour au profil
								{% endif %}
							</a>
							
							<div class="d-flex gap-2">
								<button class="btn-edit" type="submit">
									<i class="bi bi-check-lg me-2"></i>
									{% if not pastry_chef.isProfileCompleted %}
										Compléter le profil
									{% else %}
										Enregistrer les modifications
									{% endif %}
								</button>
						{{ form_end(form) }}
								{{ include('pastry_chef/_delete_form.html.twig') }}
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
