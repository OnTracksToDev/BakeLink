{% extends 'base.html.twig' %}

{% block title %}Nouveau Commentaire
{% endblock %}

{% block body %}
	<div
		class="container py-5">
		<!-- SECTION TITRE -->
		<div class="card mb-4 bg-light">
			<div class="card-body text-center">
				<h1 class="mb-0 fw-bold">
					<i class="bi bi-chat-square-text me-2"></i>Nouveau Commentaire
				</h1>
				<p class="text-muted mb-0 mt-2">Partagez votre avis</p>
			</div>
		</div>

		<!-- SECTION FORMULAIRE -->
		<div class="row justify-content-center">
			<div class="col-md-10 col-lg-8">
				<div class="card border-0 shadow-sm bg-light">
					<div class="card-body p-4">
						{{ form_errors(form) }}
						{{ form_start(form) }}

						<!-- Contenu du commentaire -->
						<div class="mb-4">
							<h4 class="fw-bold text-dark mb-3 border-bottom pb-2">
								<i class="bi bi-pencil me-2"></i>Votre commentaire
							</h4>

							<div class="mb-3">
								{{ form_label(form.contentComment, 'Message', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-light align-items-start pt-3">
										<i class="bi bi-chat-text text-muted"></i>
									</span>
									{{ form_widget(form.contentComment, {
										'attr': {
											'class': 'form-control',
											'rows': 6,
											'placeholder': 'Exprimez votre avis sur ce pâtissier...'
										}
									}) }}
								</div>
								{{ form_errors(form.contentComment) }}
							</div>
						</div>

						<!-- Champs cachés -->
						{{ form_widget(form.createdAt, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.updatedAt, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.client, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.pastryChef, {'attr': {'hidden': true}}) }}

						<!-- BOUTONS ACTION -->
						<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
							<a href="javascript:history.back()" class="btn btn-outline-secondary">
								<i class="bi bi-arrow-left me-2"></i>Annuler
							</a>

							<button class="btn btn-dark" type="submit">
								<i class="bi bi-send me-2"></i>Publier le commentaire
							</button>
						</div>

						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
