{% extends 'base.html.twig' %}

{% block title %}Commentaire de
	{{ comment_pastry_chef.client.pseudo }}
{% endblock %}

{% block body %}
	<div
		class="container py-5">
		<!-- SECTION TITRE -->
		<div class="card mb-4 bg-light">
			<div class="card-body text-center">
				<h1 class="mb-0 fw-bold">
					<i class="bi bi-chat-quote me-2"></i>Commentaire
				</h1>
				<p class="text-muted mb-0 mt-2">De
					{{ comment_pastry_chef.client.pseudo }}</p>
			</div>
		</div>

		<!-- SECTION DÉTAILS DU COMMENTAIRE -->
		<div class="row justify-content-center">
			<div class="col-md-10 col-lg-8">
				<div class="card border-0 shadow-sm">
					<div
						class="card-body p-4">
						<!-- En-tête avec informations utilisateur -->
						<div class="d-flex align-items-center mb-4 pb-3 border-bottom">
							<div class="rounded-circle overflow-hidden me-3" style="width: 50px; height: 50px;">
								<img src="{{ comment_pastry_chef.client.photoUrl ?? '/images/default-avatar.png' }}" alt="{{ comment_pastry_chef.client.pseudo }}" class="w-100 h-100 object-fit-cover">
							</div>
							<div>
								<h5 class="fw-bold mb-1">{{ comment_pastry_chef.client.pseudo }}</h5>
								<small class="text-muted">
									<i class="bi bi-calendar me-1"></i>
									{{ comment_pastry_chef.createdAt ? comment_pastry_chef.createdAt|date('d/m/Y à H:i') : '' }}
								</small>
							</div>
						</div>

						<!-- Contenu du commentaire -->
						<div class="mb-4">
							<h6 class="fw-bold text-dark mb-3">
								<i class="bi bi-chat-text me-2"></i>Commentaire
							</h6>
							<div class="bg-light rounded p-4">
								<p class="mb-0 fs-6">{{ comment_pastry_chef.contentComment }}</p>
							</div>
						</div>

						<!-- Informations supplémentaires -->
						<div class="mb-4">
							<h6 class="fw-bold text-dark mb-3">
								<i class="bi bi-info-circle me-2"></i>Informations
							</h6>
							<div class="row">
								<div class="col-md-6 mb-3">
									<small class="text-muted d-block">Pâtissier concerné :</small>
									{% if comment_pastry_chef.pastryChef is not null %}
										<div class="d-flex align-items-center mt-1">
											<div class="rounded-circle overflow-hidden me-2" style="width: 30px; height: 30px;">
												<img src="{{ comment_pastry_chef.pastryChef.photoUrl ?? '/images/default-avatar.png' }}" alt="{{ comment_pastry_chef.pastryChef.pseudo }}" class="w-100 h-100 object-fit-cover">
											</div>
											<a href="{{ path('app_pastry_chef_show', {'id': comment_pastry_chef.pastryChef.id}) }}" class="fw-semibold text-decoration-none text-dark">
												{{ comment_pastry_chef.pastryChef.pseudo }}
											</a>
										</div>
									{% else %}
										<span class="text-muted fst-italic">Non associé</span>
									{% endif %}
								</div>
							</div>
						</div>

						<!-- ACTIONS -->
						{% if is_granted('COMMENT_PASTRY_CHEF_EDIT', comment_pastry_chef) %}
							<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
								<a href="javascript:history.back()" class="btn btn-outline-secondary">
									<i class="bi bi-arrow-left me-2"></i>Retour
								</a>

								<div class="btn-group btn-group-sm">
									<a href="{{ path('app_comment_pastry_chef_edit', {'id': comment_pastry_chef.id}) }}" class="btn btn-outline-primary">
										<i class="bi bi-pencil me-1"></i>
										<span class="d-none d-md-inline">Modifier</span>
									</a>
									{{ include('comment_pastry_chef/_delete_form.html.twig') }}
								</div>
							</div>
						{% else %}
							<div class="text-center">
								<a href="javascript:history.back()" class="btn btn-outline-secondary">
									<i class="bi bi-arrow-left me-2"></i>Retour
								</a>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
