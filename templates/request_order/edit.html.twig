{% extends 'base.html.twig' %}

{% block title %}Modifier Demande de Service
{% endblock %}

{% block body %}
	<div
		class="container py-5">
		<!-- SECTION TITRE -->
		<div class="card mb-4 bg-light">
			<div class="card-body text-center">
				<h1 class="mb-0 fw-bold"></i>Modifier la Demande de Service
			</h1>
			<p class="text-muted mb-0 mt-2">Demande #{{ request_order.id }}</p>
		</div>
	</div>

	<!-- SECTION FORMULAIRE -->
	<div class="row justify-content-center">
		<div class="col-md-10 col-lg-8">
			<div class="card border-0 shadow-sm bg-light">
				<div class="card-body p-4">
					{{ form_errors(form) }}
					{{ form_start(form) }}

					<!-- Statut -->
					<div class="mb-4">
						<h4 class="fw-bold mb-3 border-bottom pb-2">
							<i class="bi bi-list-check me-2"></i>Statut de la demande
						</h4>

						<div class="mb-3">
							{{ form_label(form.status, 'Statut', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
							<div class="input-group">
								<span class="input-group-text bg-body">
									<i class="bi bi-gear text-muted"></i>
								</span>
								{{ form_widget(form.status, {
									'attr': {
										'class': 'form-select'
									}
								}) }}
							</div>
							{{ form_errors(form.status) }}
							<div class="form-text">
								<small>
									<i class="bi bi-info-circle me-1"></i>
									Choisissez le statut approprié pour cette demande
								</small>
							</div>
						</div>
					</div>

					<!-- Description -->
					<div class="mb-4">
						<h4 class="fw-bold mb-3 border-bottom pb-2">
							<i class="bi bi-chat-text me-2"></i>Description de la demande
						</h4>

						<div class="mb-3">
							{{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
							<div class="input-group">
								<span class="input-group-text bg-body align-items-center pt-3">
									<i class="bi bi-text-paragraph text-muted"></i>
								</span>
								{{ form_widget(form.description, {
										'attr': {
											'class': 'form-control',
											'rows': 6,
											'placeholder': 'Décrivez votre demande de service en détail...'
										}
									}) }}
							</div>
							{{ form_errors(form.description) }}
						</div>
					</div>
					<!-- Date de Réalisation -->
					<div class="mb-4">
						<h4 class="fw-bold mb-3 border-bottom pb-2">
							<i class="bi bi-calendar-date me-2"></i>Date de Réalisation
						</h4>

						<div class="mb-3">
							{{ form_label(form.finishedAt, 'Date de réalisation de la pâtisserie', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
							<div class="input-group">
								<span class="input-group-text bg-body">
									<i class="bi bi-calendar-check text-muted"></i>
								</span>
								{{ form_widget(form.finishedAt, {'attr': {'class': 'form-control','placeholder': 'Sélectionnez la date de réalisation'}}) }}
							</div>
							{{ form_errors(form.finishedAt) }}
							<div class="form-text">
								<small class="text-muted">
									<i class="bi bi-info-circle me-1"></i>
									Date à laquelle la pâtisserie est réalisée
								</small>
							</div>
						</div>
					</div>

					<!-- Champs cachés -->
					{{ form_widget(form.createdAt, {'attr': {'hidden': true}}) }}
					{{ form_widget(form.eventDate, {'attr': {'hidden': true}}) }}
					{{ form_widget(form.updatedAt, {'attr': {'hidden': true}}) }}
					{{ form_widget(form.client, {'attr': {'hidden': true}}) }}
					{{ form_widget(form.pastryChef, {'attr': {'hidden': true}}) }}

					<!-- BOUTONS ACTION -->
					<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
						<a href="{{ path('app_request_order_show', {'id': request_order.id}) }}" class="btn-cancel">
							<i class="bi bi-arrow-left me-2"></i>Retour aux détails
						</a>

						<div class="d-flex gap-2">
							<button class="btn-edit" type="submit">
								<i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
							</button>
							{{ form_end(form) }}
							{{ include('request_order/_delete_form.html.twig') }}
						</div>
					</div>

				</div>
			</div>
		</div>
	</div>
</div>{% endblock %}
