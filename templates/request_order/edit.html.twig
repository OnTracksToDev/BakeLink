{% extends 'base.html.twig' %}

{% block title %}Modifier Demande de Service
{% endblock %}

{% block body %}
	<div class="container py-5">
		<!-- SECTION TITRE -->
		<div class="card mb-4 bg-light">
			<div class="card-body text-center">
				<h1 class="mb-0 fw-bold">
					<i class="bi bi-pencil-square me-2"></i>Modifier la Demande de Service
				</h1>
				<p class="text-muted mb-0 mt-2">Demande #{{ request_order.id }}</p>
			</div>
		</div>

		<!-- SECTION FORMULAIRE -->
		<div class="row justify-content-center">
			<div class="col-md-10 col-lg-8">
				<div class="card border-0 shadow-sm bg-light">
					<div class="card-body p-4">
						{{ form_errors(form) }}
						{{ form_start(form) }}

						<!-- Description -->
						<div class="mb-4">
							<h4 class="fw-bold text-dark mb-3 border-bottom pb-2">
								<i class="bi bi-chat-text me-2"></i>Description de la demande
							</h4>
							
							<div class="mb-3">
								{{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-light align-items-start pt-3">
										<i class="bi bi-text-paragraph text-muted"></i>
									</span>
									{{ form_widget(form.description, {
										'attr': {
											'class': 'form-control',
											'rows': 6,
											'placeholder': 'Décrivez votre demande de service en détail...'
										}
									}) }}
								</div>
								{{ form_errors(form.description) }}
							</div>
						</div>

						<!-- Statut -->
						<div class="mb-4">
							<h4 class="fw-bold text-dark mb-3 border-bottom pb-2">
								<i class="bi bi-list-check me-2"></i>Statut de la demande
							</h4>

							<div class="mb-3">
								{{ form_label(form.status, 'Statut', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-light">
										<i class="bi bi-gear text-muted"></i>
									</span>
									{{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
								</div>
								{{ form_errors(form.status) }}
							</div>
						</div>

						<!-- Champs cachés -->
						{{ form_widget(form.createdAt, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.client, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.pastryChef, {'attr': {'hidden': true}}) }}

						<!-- BOUTONS ACTION -->
						<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
							<a href="{{ path('app_request_order_show', {'id': request_order.id}) }}" class="btn btn-outline-secondary">
								<i class="bi bi-arrow-left me-2"></i>Retour aux détails
							</a>
							
							<div class="d-flex gap-2">
								{{ include('request_order/_delete_form.html.twig') }}
								<button class="btn btn-dark" type="submit">
									<i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
								</button>
							</div>
						</div>

						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}