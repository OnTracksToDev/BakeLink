{% extends 'base.html.twig' %}

{% block title %}Demandes de service
{% endblock %}

{% block body %}
	<div
		class="container py-5">

		<!-- HEADER -->
		<div class="text-center mb-5">
			{% set requestCount = requests|length %}

			{% if is_granted('ROLE_CLIENT') %}
				<h2 class="fw-bold">
					{% if requestCount == 1 %}
						Ma demande de service envoyée
					{% else %}
						Mes demandes de service envoyées
					{% endif %}
				</h2>
			{% elseif is_granted('ROLE_CHEF') %}
				<h2 class="fw-bold">
					{% if requestCount == 1 %}
						Ma demande de service reçue
					{% else %}
						Mes demandes de service reçues
					{% endif %}
				</h2>
			{% endif %}
			<p class="text-muted">Suivez vos échanges et l’état de chaque demande en un coup d’œil.</p>
		</div>

		<!-- LISTE DES DEMANDES -->
		{% if requests is not empty %}
			<div class="row g-4">
				{% for request in requests %}
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm bg-light">
							<div class="card-body d-flex flex-column">

								<div class="d-flex justify-content-between align-items-start mb-3">
									<span class="badge
																						                                    {% if request.status == 'En attente' %}
																						                                        bg-warning text-dark
																						                                    {% elseif request.status == 'En cours' %}
																						                                        bg-info text-dark
																						                                    {% elseif request.status == 'Terminé' %}
																						                                        bg-success
																						                                    {% elseif request.status == 'Annulé' %}
																						                                        bg-danger
																						                                    {% else %}
																						                                        bg-secondary
																						                                    {% endif %}
																						                                    ">
										{{ request.status }}
									</span>
									<small class="text-muted">{{ request.createdAt|date('d/m/Y H:i') }}</small>
								</div>

								<h5 class="card-title fw-bold mb-3">
									{{ request.description|length > 60 ? request.description|slice(0, 60) ~ '...' : request.description }}
								</h5>

								<ul class="list-unstyled small mb-4">
									<li class="mb-2">
										<i class="bi bi-person-fill me-2 text-secondary"></i>
										<strong>Client :</strong>
										{{ request.client.pseudo }}
									</li>
									<li>
										<i class="bi bi-cake me-2 text-secondary"></i>
										<strong>Pâtissier :</strong>
										{{ request.pastryChef.pseudo }}
									</li>
								</ul>

								<div class="mt-auto text-end">
									<a href="{{ path('app_request_order_show', {'id': request.id}) }}" class="btn btn-outline-dark btn-sm rounded-pill px-3">
										<i class="bi bi-eye me-1"></i>
										Voir détails
									</a>
								</div>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<div class="alert alert-secondary text-center py-4 mt-4" role="alert">
				<i class="bi bi-inbox me-2"></i>Aucune demande de service pour le moment.
			</div>
		{% endif %}

		<!-- BOUTON DE RETOUR -->
		<div class="text-center mt-5">
			{% if is_granted('ROLE_CLIENT') %}
				<a href="{{ path('app_client_show', {'id': app.user.id}) }}" class="btn btn-outline-dark">
					<i class="bi bi-arrow-left me-2"></i>Retour au Profil de
					{{ app.user.pseudo }}
				</a>
			{% elseif is_granted('ROLE_CHEF') %}
				<a href="{{ path('app_pastry_chef_show', {'id': app.user.id}) }}" class="btn btn-outline-dark">
					<i class="bi bi-arrow-left me-2"></i>Retour au Profil de
					{{ app.user.pseudo }}
				</a>
			{% endif %}
		</div>

	</div>
{% endblock %}
