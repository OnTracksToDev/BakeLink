{% extends 'base.html.twig' %}

{% block title %}Nouvelle Pâtisserie
{% endblock %}

{% block body %}
	<div
		class="container py-5">
		<!-- SECTION TITRE -->
		<div class="card mb-4 bg-light">
			<div class="card-body text-center">
				<h1 class="mb-0 fw-bold">
					<i class="bi bi-plus-circle me-2"></i>Nouvelle Pâtisserie
				</h1>
				<p class="text-muted mb-0 mt-2">Ajoutez une création à votre portfolio</p>
			</div>
		</div>

		<!-- SECTION FORMULAIRE -->
		<div class="row justify-content-center">
			<div class="col-md-10 col-lg-8">
				<div class="card border-0 shadow-sm bg-light">
					<div class="card-body p-4">
						{{ form_errors(form) }}
						{{ form_start(form) }}

						<!-- Informations principales -->
						<div class="mb-4">
							<h4 class="fw-bold text-dark mb-3 border-bottom pb-2">
								<i class="bi bi-info-circle me-2"></i>Informations principales
							</h4>

							<div class="mb-3">
								{{ form_label(form.title, 'Titre de la pâtisserie', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-light">
										<i class="bi bi-type text-muted"></i>
									</span>
									{{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Fraisier maison, Tarte aux pommes...'}}) }}
								</div>
								{{ form_errors(form.title) }}
							</div>

							<div class="mb-3">
								{{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-light align-items-start pt-3">
										<i class="bi bi-text-paragraph text-muted"></i>
									</span>
									{{ form_widget(form.description, {
										'attr': {
											'class': 'form-control',
											'rows': 4,
											'placeholder': 'Décrivez votre pâtisserie : ingrédients, saveurs, particularités...'
										}
									}) }}
								</div>
								{{ form_errors(form.description) }}
							</div>
						</div>

						<!-- Image et catégorie -->
						<div class="mb-4">
							<h4 class="fw-bold text-dark mb-3 border-bottom pb-2">
								<i class="bi bi-image me-2"></i>Présentation
							</h4>

							<div class="row">
								<div class="col-md-6 mb-3">
									{{ form_label(form.photoUrl, 'Photo', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
									<div class="input-group">
										<span class="input-group-text bg-light">
											<i class="bi bi-link-45deg text-muted"></i>
										</span>
										{{ form_widget(form.photoUrl, {'attr': {'class': 'form-control', 'placeholder': 'URL de la photo'}}) }}
									</div>
									{{ form_errors(form.photoUrl) }}
									<small class="text-muted">Ajoutez un lien vers une image de qualité</small>
								</div>

								<div class="col-md-6 mb-3">
									{{ form_label(form.category, 'Catégorie', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
									<div class="input-group">
										<span class="input-group-text bg-light">
											<i class="bi bi-tag text-muted"></i>
										</span>
										{{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
									</div>
									{{ form_errors(form.category) }}
								</div>
							</div>
						</div>

						<!-- BOUTONS ACTION -->
						<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
							<a href="{{ path('app_pastry_chef_show', {'id': app.user.id}) }}" class="btn btn-outline-secondary">
								<i class="bi bi-arrow-left me-2"></i>Retour au profil
							</a>

							<button class="btn btn-dark" type="submit">
								<i class="bi bi-check-lg me-2"></i>Créer la pâtisserie
							</button>
						</div>

						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
