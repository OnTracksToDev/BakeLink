{% extends 'base.html.twig' %}

{% block title %}Modifier Profil
{% endblock %}

{% block body %}
	<div
		class="container py-5">

		<!-- HEADER -->
		<div class="card mb-4 bg-light">
			<div class="card-body d-flex align-items-center justify-content-between">
				<div class="d-flex align-items-center">
					<div class="rounded-circle overflow-hidden" style="width:80px; height:80px;">
						<img src="{{ client.photoUrl }}" alt="{{ client.firstname }} {{ client.lastname }}" class="w-100 h-100 object-fit-cover">
					</div>
					<div class="ms-3">
						<h5 class="fw-bold mb-0">Modifier le Profil de {{ client.pseudo }}</h5>
					</div>
				</div>
				<a href="{{ path('app_client_show', {'id': client.id}) }}" class="btn btn-outline-dark">
					Retour au Profil
				</a>
			</div>
		</div>

		<!-- FORMULAIRE -->
		<div class="card border-0 bg-light">
			<div class="card-body px-4 py-5">
				<h4 class="fw-bold mb-4 text-center text-dark">Informations du Profil</h4>

				{{ form_start(form) }}

				<!-- EMAIL -->
				<div class="mb-3">
					<label class="form-label fw-semibold text-dark">Email</label>
					{{ form_widget(form.email, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
				</div>

				<!-- NOM / PRENOM -->
				<div class="row mb-3">
					<div class="col-md-6">
						<label class="form-label fw-semibold text-dark">Prénom</label>
						{{ form_widget(form.firstname, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
					</div>
					<div class="col-md-6">
						<label class="form-label fw-semibold text-dark">Nom</label>
						{{ form_widget(form.lastname, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
					</div>
				</div>

				<!-- PSEUDO / TEL -->
				<div class="row mb-3">
					<div class="col-md-6">
						<label class="form-label fw-semibold text-dark">Pseudo</label>
						{{ form_widget(form.pseudo, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
					</div>
					<div class="col-md-6">
						<label class="form-label fw-semibold text-dark">Téléphone</label>
						{{ form_widget(form.phone, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
					</div>
				</div>

				<!-- LIEN SOCIAL -->
				<div class="mb-3">
					<label class="form-label fw-semibold text-dark">Lien social</label>
					{{ form_widget(form.socialLink, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
				</div>

				<!-- VILLE / PHOTO -->
				<div class="row mb-3">
					<div class="col-md-6">
						<label class="form-label fw-semibold text-dark">Ville</label>
						{{ form_widget(form.city, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
					</div>
					<div class="col-md-6">
						<label class="form-label fw-semibold text-dark">Photo</label>
						{{ form_widget(form.photoUrl, {'attr': {'class': 'form-control border-0 bg-white rounded-3 p-3 text-dark'}}) }}
					</div>
				</div>

				<!-- CACHER-->
				{{ form_row(form.password, {
                    'attr': {
                        'hidden': true,
                    },
                    'label_attr': {
                        'style': 'display: none;'
                    }
                })}}


				{{ form_widget(form._token) }}

				<!-- BOUTONS -->
				<div class="d-flex justify-content-between mt-5">
					<button type="submit" class="btn btn-outline-dark">
						Valider
					</button>
					{{ include('client/_delete_form.html.twig') }}
				</div>
				{{ form_end(form, { render_rest: false }) }}
			</div>
		</div>
	</div>
{% endblock %}
