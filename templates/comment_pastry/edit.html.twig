{% extends 'base.html.twig' %}

{% block title %}
	Modifier Commentaire
{% endblock %}

{% block body %}
	<div
		class="container py-5">
		<!-- SECTION TITRE -->
		<div class="card mb-4 bg-light">
			<div class="card-body text-center">
				<h1 class="mb-0 fw-bold">
					<i class="bi bi-pencil-square me-2"></i>Modifier le Commentaire
				</h1>
				<p class="text-muted mb-0 mt-2">Sur
					{{ pastry.title }}</p>
			</div>
		</div>

		<!-- SECTION FORMULAIRE -->
		<div class="row justify-content-center">
			<div class="col-md-10 col-lg-8">
				<div class="card border-0 shadow-sm bg-light">
					<div class="card-body p-4">
						{{ form_errors(form) }}
						{{ form_start(form) }}

						<!-- Contenu du commentaire -->
						<div class="mb-4">
							<h4 class="fw-bold text-dark mb-3 border-bottom pb-2">
								<i class="bi bi-chat-text me-2"></i>Votre commentaire
							</h4>

							<div class="mb-3">
								{{ form_label(form.contentComment, 'Contenu', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
								<div class="input-group">
									<span class="input-group-text bg-light align-items-start pt-3">
										<i class="bi bi-text-paragraph text-muted"></i>
									</span>
									{{ form_widget(form.contentComment, {
										'attr': {
											'class': 'form-control',
											'rows': 6,
											'placeholder': 'Exprimez votre avis sur cette pâtisserie...'
										}
									}) }}
								</div>
								{{ form_errors(form.contentComment) }}
							</div>
						</div>

						<!-- Champs cachés -->
						{{ form_widget(form.createdAt, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.updatedAt, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.pastry, {'attr': {'hidden': true}}) }}
						{{ form_widget(form.client, {'attr': {'hidden': true}}) }}

						<!-- BOUTONS ACTION -->
						<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
							<div>
								<a href="javascript:history.back()" class="btn btn-outline-secondary me-2">
									<i class="bi bi-arrow-left me-2"></i>Retour
								</a>
								<a href="{{ path('app_pastry_show', {'id': pastry.id}) }}" class="btn btn-outline-dark">
									<i class="bi bi-eye me-2"></i>Voir la pâtisserie
								</a>
							</div>

							<div class="d-flex gap-2">
								<button class="btn btn-dark" type="submit">
									<i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
								</button>
						{{ form_end(form) }}
								{{ include('comment_pastry/_delete_form.html.twig') }}
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
